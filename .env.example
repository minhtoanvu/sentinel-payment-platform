# SentinelQA - Payment Lab Configuration
# Copy to .env and adjust values

# Database
DATABASE_URL=postgresql+asyncpg://sentinelqa:sentinelqa_dev@localhost:5432/sentinelqa

# Application
ENVIRONMENT=development
LOG_LEVEL=DEBUG
API_PREFIX=/api/v1

# Webhook
WEBHOOK_SECRET=dev-webhook-secret-key-min-32-chars!!

# Provider Simulator
PROVIDER_TIMEOUT_SECONDS=10

# Payment Configuration
PAYMENT_EXPIRY_MINUTES=30
STATUS_QUERY_MAX_ATTEMPTS=5

# Refund Configuration
REFUND_WINDOW_DAYS=180
MAX_REFUNDS_PER_PAYMENT=10
REFUND_APPROVAL_THRESHOLD_VND=10000000
REFUND_APPROVAL_THRESHOLD_USD_CENTS=40000

# Idempotency
IDEMPOTENCY_TTL_HOURS=24

# Webhook
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# Business timezone
BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh

# Seeded defects (set to 1 to enable)
PL_DEFECT_BUG_001=0
PL_DEFECT_BUG_002=0
PL_DEFECT_BUG_003=0
PL_DEFECT_BUG_004=0
PL_DEFECT_BUG_005=0
PL_DEFECT_BUG_006=0
PL_DEFECT_BUG_007=0
PL_DEFECT_BUG_008=0
PL_DEFECT_BUG_009=0
PL_DEFECT_BUG_010=0
PL_DEFECT_BUG_011=0
PL_DEFECT_BUG_012=0
PL_DEFECT_BUG_013=0
PL_DEFECT_BUG_014=0
PL_DEFECT_BUG_015=0
PL_DEFECT_BUG_016=0
PL_DEFECT_BUG_017=0
PL_DEFECT_BUG_018=0
